rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dokumen kode akses: siapa saja boleh membaca (hanya berisi hash, bukan kode asli),
    // tapi menulis hanya boleh oleh pengguna yang sudah masuk anonim (yaitu, lewat aplikasi ini).
    match /system/access {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Metadata file: boleh dibaca siapa saja, dibuat/dihapus oleh pengguna anonim (lewat aplikasi).
    match /files/{fileId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if false;
    }
  }
}
